{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trellix EDR Action History Alerts API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.manage.trellix.com/edr/v2/alerts",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return per page"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip for pagination"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Return alerts generated after this ISO 8601 timestamp."
              },
              {
                "name": "severity",
                "value": "",
                "type": "query",
                "description": "Filter alerts by severity level"
              }
            ]
          },
          "docs": "Retrieve discrete detection alerts containing process, user, and host context. Alerts include trace identifiers, detection dates, event types, severity scores, and detection tags."
        }
      ]
    }
  ],
  "bundled": true
}